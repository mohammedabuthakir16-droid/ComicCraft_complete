# ComicCraft Environment Configuration
# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=

# Primary Gemini Model for Story and Panel Generation
# Recommended: gemini-2.5-flash or gemini-1.5-flash
TEXT_MODEL=gemini-2.5-flash

# Image Generation Provider: "pollinations", "huggingface", or "mock"
# Default "pollinations" provides free, zero-config high quality comic generation
IMAGE_PROVIDER=pollinations

# Hugging Face API Token (optional, used if IMAGE_PROVIDER=huggingface)
HF_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
