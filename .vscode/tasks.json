{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start ComicCraft Studio Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python main.py",
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest -v",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
